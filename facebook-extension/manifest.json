{
  "manifest_version": 3,
  "name": "Content Blueprint for Facebook",
  "short_name": "Content Blueprint",
  "version": "0.3.0",
  "minimum_chrome_version": "114",
  "description": "สร้าง ตรวจทาน และแทรกร่างคอนเทนต์ใน Facebook โดยผู้ใช้เป็นคนกดโพสต์เอง",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "key": "",
  "permissions": [
    "nativeMessaging",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "เปิด Content Blueprint",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
